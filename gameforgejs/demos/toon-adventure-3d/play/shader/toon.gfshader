{
  "format": "gameforge.shader",
  "version": 1,
  "name": "toon",
  "domain": "surface",
  "description": "Banded (toon) lighting for every surface in Toon Adventure: albedo map × color, the scene's lights in render.toonBands flat bands. The B key cycles the bands at runtime (material.bands).",
  "properties": [
    {
      "name": "uAlbedoMap",
      "type": "texture",
      "default": "white",
      "label": "Albedo map"
    },
    {
      "name": "uColor",
      "type": "color",
      "default": [
        1,
        1,
        1,
        1
      ],
      "label": "Color"
    }
  ],
  "render": {
    "transparent": false,
    "cull": "back",
    "subdivision": 0,
    "toonBands": 3
  },
  "graph": {
    "nodes": [
      {
        "id": "albedoMap",
        "type": "property",
        "x": 40,
        "y": 60,
        "params": {
          "name": "uAlbedoMap"
        }
      },
      {
        "id": "sample",
        "type": "sampleTexture",
        "x": 280,
        "y": 60,
        "params": {}
      },
      {
        "id": "color",
        "type": "property",
        "x": 280,
        "y": 240,
        "params": {
          "name": "uColor"
        }
      },
      {
        "id": "tint",
        "type": "multiply",
        "x": 520,
        "y": 120,
        "params": {}
      },
      {
        "id": "opacity",
        "type": "multiply",
        "x": 520,
        "y": 220,
        "params": {}
      },
      {
        "id": "rough",
        "type": "float",
        "x": 520,
        "y": 340,
        "params": {
          "value": 1
        }
      },
      {
        "id": "out",
        "type": "output",
        "x": 760,
        "y": 120,
        "params": {}
      }
    ],
    "links": [
      {
        "from": {
          "node": "albedoMap",
          "port": "texture"
        },
        "to": {
          "node": "sample",
          "port": "texture"
        }
      },
      {
        "from": {
          "node": "sample",
          "port": "rgb"
        },
        "to": {
          "node": "tint",
          "port": "a"
        }
      },
      {
        "from": {
          "node": "color",
          "port": "color"
        },
        "to": {
          "node": "tint",
          "port": "b"
        }
      },
      {
        "from": {
          "node": "sample",
          "port": "alpha"
        },
        "to": {
          "node": "opacity",
          "port": "a"
        }
      },
      {
        "from": {
          "node": "color",
          "port": "alpha"
        },
        "to": {
          "node": "opacity",
          "port": "b"
        }
      },
      {
        "from": {
          "node": "opacity",
          "port": "result"
        },
        "to": {
          "node": "out",
          "port": "alpha"
        }
      },
      {
        "from": {
          "node": "tint",
          "port": "result"
        },
        "to": {
          "node": "out",
          "port": "albedo"
        }
      },
      {
        "from": {
          "node": "rough",
          "port": "value"
        },
        "to": {
          "node": "out",
          "port": "roughness"
        }
      }
    ],
    "preview": {
      "mesh": "sphere"
    }
  },
  "glsl": {
    "fragment": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (domain: surface).\n#include <gf_surface>\n\nuniform sampler2D uAlbedoMap;\nuniform vec4 uColor;\n\nvoid main() {\n    gfClipReflection();\n    vec4 n1_rgba = texture(uAlbedoMap, vUv);\n    vec3 n1_rgb = texture(uAlbedoMap, vUv).rgb;\n    float n1_alpha = texture(uAlbedoMap, vUv).a;\n    vec3 n2_color = uColor.rgb;\n    float n2_alpha = uColor.a;\n    vec4 n2_rgba = uColor;\n    vec3 n3_result = (n1_rgb * n2_color);\n    float n5_value = 1.0;\n    float n4_result = (n1_alpha * n2_alpha);\n    GFSurface s = gfDefaultSurface();\n    s.albedo = n3_result;\n    s.roughness = n5_value;\n    s.alpha = n4_result;\n    gfWriteSurface(s);\n}\n"
  }
}
