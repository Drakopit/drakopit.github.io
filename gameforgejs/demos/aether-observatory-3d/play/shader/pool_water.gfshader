{
  "format": "gameforge.shader",
  "version": 1,
  "name": "Reflecting pool",
  "domain": "surface",
  "description": "Animated waves and a deep tint for the observatory's pools.",
  "properties": [
    {
      "name": "uDeepColor",
      "type": "color",
      "default": [
        0.05,
        0.36,
        0.42,
        1
      ],
      "label": "Deep color"
    },
    {
      "name": "uWaveHeight",
      "type": "float",
      "default": 0.03,
      "min": 0,
      "max": 0.3
    }
  ],
  "render": {
    "transparent": false,
    "cull": "back",
    "subdivision": 1
  },
  "graph": {
    "nodes": [
      {
        "id": "waves",
        "type": "waterNormal",
        "x": 40,
        "y": 60,
        "params": {
          "scale": 1.6,
          "strength": 1.4
        }
      },
      {
        "id": "deep",
        "type": "property",
        "x": 40,
        "y": 200,
        "params": {
          "name": "uDeepColor"
        }
      },
      {
        "id": "pos",
        "type": "worldPosition",
        "x": 40,
        "y": 330,
        "params": {}
      },
      {
        "id": "split",
        "type": "split",
        "x": 240,
        "y": 330,
        "params": {}
      },
      {
        "id": "time",
        "type": "time",
        "x": 40,
        "y": 450,
        "params": {
          "speed": 1.2
        }
      },
      {
        "id": "phase",
        "type": "add",
        "x": 440,
        "y": 380,
        "params": {}
      },
      {
        "id": "wave",
        "type": "sine",
        "x": 640,
        "y": 380,
        "params": {}
      },
      {
        "id": "height",
        "type": "property",
        "x": 640,
        "y": 500,
        "params": {
          "name": "uWaveHeight"
        }
      },
      {
        "id": "dispMul",
        "type": "multiply",
        "x": 840,
        "y": 420,
        "params": {}
      },
      {
        "id": "rough",
        "type": "float",
        "x": 440,
        "y": 200,
        "params": {
          "value": 0.08
        }
      },
      {
        "id": "coat",
        "type": "float",
        "x": 440,
        "y": 260,
        "params": {
          "value": 0.6
        }
      },
      {
        "id": "rim",
        "type": "float",
        "x": 640,
        "y": 260,
        "params": {
          "value": 0.35
        }
      },
      {
        "id": "out",
        "type": "output",
        "x": 1060,
        "y": 120,
        "params": {}
      }
    ],
    "links": [
      {
        "from": {
          "node": "waves",
          "port": "normal"
        },
        "to": {
          "node": "out",
          "port": "normal"
        }
      },
      {
        "from": {
          "node": "deep",
          "port": "color"
        },
        "to": {
          "node": "out",
          "port": "albedo"
        }
      },
      {
        "from": {
          "node": "rough",
          "port": "value"
        },
        "to": {
          "node": "out",
          "port": "roughness"
        }
      },
      {
        "from": {
          "node": "coat",
          "port": "value"
        },
        "to": {
          "node": "out",
          "port": "clearcoat"
        }
      },
      {
        "from": {
          "node": "rim",
          "port": "value"
        },
        "to": {
          "node": "out",
          "port": "rim"
        }
      },
      {
        "from": {
          "node": "pos",
          "port": "position"
        },
        "to": {
          "node": "split",
          "port": "vector"
        }
      },
      {
        "from": {
          "node": "split",
          "port": "x"
        },
        "to": {
          "node": "phase",
          "port": "a"
        }
      },
      {
        "from": {
          "node": "time",
          "port": "time"
        },
        "to": {
          "node": "phase",
          "port": "b"
        }
      },
      {
        "from": {
          "node": "phase",
          "port": "result"
        },
        "to": {
          "node": "wave",
          "port": "value"
        }
      },
      {
        "from": {
          "node": "wave",
          "port": "result"
        },
        "to": {
          "node": "dispMul",
          "port": "a"
        }
      },
      {
        "from": {
          "node": "height",
          "port": "value"
        },
        "to": {
          "node": "dispMul",
          "port": "b"
        }
      },
      {
        "from": {
          "node": "dispMul",
          "port": "result"
