        "to": {
          "node": "out",
          "port": "displacement"
        }
      }
    ],
    "preview": {
      "mesh": "plane"
    }
  },
  "glsl": {
    "vertex": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (vertex stage, domain: surface).\n#include <gf_vertex>\n\nuniform vec3 uCameraPosition;\nuniform float uTime;\nuniform vec4 uDeepColor;\nuniform float uWaveHeight;\n\nvoid main() {\n    vec3 gfWorldPosition = (uModel * vec4(aPosition, 1.0)).xyz;\n    vec3 gfWorldNormal = normalize(mat3(uNormalMatrix) * aNormal);\n    vec3 n2_position = gfWorldPosition;\n    float n3_x = n2_position.x;\n    float n3_y = n2_position.y;\n    float n3_z = n2_position.z;\n    float n4_time = (uTime * 1.2);\n    float n5_result = (n3_x + n4_time);\n    float n6_result = sin(n5_result);\n    float n7_value = uWaveHeight;\n    float n8_result = (n6_result * n7_value);\n    gfEmitVertex(aPosition + normalize(aNormal) * n8_result, aNormal, aTangent, aUv);\n}\n",
    "fragment": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (domain: surface).\n#include <gf_surface>\n\nuniform vec4 uDeepColor;\nuniform float uWaveHeight;\n\nvec3 gfgWaterNormal(vec3 normal, vec2 p, float t, float strength) {\n    vec2 slope = vec2(0.8, 0.6) * cos(dot(p, vec2(1.7, 1.3)) - t * 1.5) * 0.055;\n    slope += vec2(-0.4, 0.9) * cos(dot(p, vec2(-1.3, 3.2)) - t * 2.2) * 0.04;\n    slope += vec2(0.97, -0.24) * cos(dot(p, vec2(8.7, -2.15)) - t * 3.3) * 0.018;\n    return normalize(normal + vec3(slope.x, 0.0, slope.y) * strength);\n}\n\nvoid main() {\n    gfClipReflection();\n    vec3 n1_color = uDeepColor.rgb;\n    float n1_alpha = uDeepColor.a;\n    vec4 n1_rgba = uDeepColor;\n    vec3 n0_normal = normalize(transpose(vTbn) * gfgWaterNormal(normalize(vNormal), vWorldPosition.xz * 1.6, uTime, 1.4));\n    float n9_value = 0.08;\n    float n10_value = 0.6;\n    float n11_value = 0.35;\n    GFSurface s = gfDefaultSurface();\n    s.albedo = n1_color;\n    s.normal = normalize(vTbn * n0_normal);\n    s.roughness = n9_value;\n    s.clearcoat = n10_value;\n    s.rim = n11_value;\n    gfWriteSurface(s);\n}\n"
  }
}
