  "glsl": {
    "vertex": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (vertex stage, domain: surface).\n#include <gf_vertex>\n\nuniform vec3 uCameraPosition;\nuniform float uTime;\nuniform vec4 uRockColor;\nuniform vec4 uMossColor;\nuniform float uMossAmount;\nuniform float uDisplacement;\n\nfloat gfgHash(vec2 p) {\n    vec3 q = fract(vec3(p.xyx) * 0.1031);\n    q += dot(q, q.yzx + 33.33);\n    return fract((q.x + q.y) * q.z);\n}\n\nfloat gfgNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(gfgHash(i), gfgHash(i + vec2(1.0, 0.0)), f.x),\n               mix(gfgHash(i + vec2(0.0, 1.0)), gfgHash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\nfloat gfgFbm(vec2 p, float octaves) {\n    float value = 0.0, amplitude = 0.5;\n    for (int i = 0; i < 8; i++) {\n        if (float(i) >= octaves) break;\n        value += amplitude * gfgNoise(p);\n        p = p * 2.03 + vec2(17.1, 9.2);\n        amplitude *= 0.5;\n    }\n    return value;\n}\n\nvoid main() {\n    vec3 gfWorldPosition = (uModel * vec4(aPosition, 1.0)).xyz;\n    vec3 gfWorldNormal = normalize(mat3(uNormalMatrix) * aNormal);\n    vec2 n0_uv = aUv;\n    float n11_value = gfgFbm(n0_uv * 5.0 + 0.0, 5.0);\n    float n12_result = (0.0 + (n11_value - 0.0) * ((1.0 - 0.0) / max(1.0 - 0.0, 1e-5)));\n    float n8_value = uDisplacement;\n    float n9_result = (n12_result * n8_value);\n    gfEmitVertex(aPosition + normalize(aNormal) * n9_result, aNormal, aTangent, aUv);\n}\n",
    "fragment": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (domain: surface).\n#include <gf_surface>\n\nuniform vec4 uRockColor;\nuniform vec4 uMossColor;\nuniform float uMossAmount;\nuniform float uDisplacement;\n\nvoid main() {\n    gfClipReflection();\n    vec3 n1_color = uRockColor.rgb;\n    float n1_alpha = uRockColor.a;\n    vec4 n1_rgba = uRockColor;\n    vec3 n2_color = uMossColor.rgb;\n    float n2_alpha = uMossColor.a;\n    vec4 n2_rgba = uMossColor;\n    float n5_value = uMossAmount;\n    vec3 n3_normal = normalize(vNormal);\n    float n4_x = n3_normal.x;\n    float n4_y = n3_normal.y;\n    float n4_z = n3_normal.z;\n    float n6_result = smoothstep(0.0, n5_value, n4_y);\n    vec3 n7_result = mix(n1_color, n2_color, n6_result);\n    GFSurface s = gfDefaultSurface();\n    s.albedo = n7_result;\n    gfWriteSurface(s);\n}\n"
  }
}
