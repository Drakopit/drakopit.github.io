  "glsl": {
    "fragment": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (domain: surface).\n#include <gf_surface>\n\nuniform vec4 uOceanColor;\nuniform vec4 uLandColor;\nuniform vec4 uAtmosphereColor;\nuniform float uAtmosphere;\n\nfloat gfgHash(vec2 p) {\n    vec3 q = fract(vec3(p.xyx) * 0.1031);\n    q += dot(q, q.yzx + 33.33);\n    return fract((q.x + q.y) * q.z);\n}\n\nfloat gfgNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(gfgHash(i), gfgHash(i + vec2(1.0, 0.0)), f.x),\n               mix(gfgHash(i + vec2(0.0, 1.0)), gfgHash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\nfloat gfgFbm(vec2 p, float octaves) {\n    float value = 0.0, amplitude = 0.5;\n    for (int i = 0; i < 8; i++) {\n        if (float(i) >= octaves) break;\n        value += amplitude * gfgNoise(p);\n        p = p * 2.03 + vec2(17.1, 9.2);\n        amplitude *= 0.5;\n    }\n    return value;\n}\n\nvoid main() {\n    gfClipReflection();\n    vec3 n3_color = uOceanColor.rgb;\n    float n3_alpha = uOceanColor.a;\n    vec4 n3_rgba = uOceanColor;\n    vec3 n4_color = uLandColor.rgb;\n    float n4_alpha = uLandColor.a;\n    vec4 n4_rgba = uLandColor;\n    vec2 n0_uv = vec2(atan(normalize(vNormal).z, normalize(vNormal).x) / 6.28318 + 0.5, normalize(vNormal).y * 0.5 + 0.5);\n    float n1_value = gfgFbm(n0_uv * 5.0 + 5.31, 6.0);\n    float n2_result = smoothstep(0.0, 1.0, n1_value);\n    vec3 n5_result = mix(n3_color, n4_color, n2_result);\n    float n7_value = uAtmosphere;\n    vec3 n6_color = uAtmosphereColor.rgb;\n    float n6_alpha = uAtmosphereColor.a;\n    vec4 n6_rgba = uAtmosphereColor;\n    GFSurface s = gfDefaultSurface();\n    s.albedo = n5_result;\n    s.rim = n7_value;\n    s.rimColor = n6_color;\n    gfWriteSurface(s);\n}\n"
  }
