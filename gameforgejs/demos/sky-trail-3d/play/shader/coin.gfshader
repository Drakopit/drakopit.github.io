  "glsl": {
    "fragment": "#version 300 es\nprecision highp float;\n\n// Generated by the GameForgeJS Editor shader graph (domain: surface).\n#include <gf_surface>\n\nuniform vec4 uPaint;\nuniform float uFlakes;\n\nfloat gfgHash(vec2 p) {\n    vec3 q = fract(vec3(p.xyx) * 0.1031);\n    q += dot(q, q.yzx + 33.33);\n    return fract((q.x + q.y) * q.z);\n}\n\nfloat gfgNoise(vec2 p) {\n    vec2 i = floor(p), f = fract(p);\n    f = f * f * (3.0 - 2.0 * f);\n    return mix(mix(gfgHash(i), gfgHash(i + vec2(1.0, 0.0)), f.x),\n               mix(gfgHash(i + vec2(0.0, 1.0)), gfgHash(i + vec2(1.0, 1.0)), f.x), f.y);\n}\n\nvoid main() {\n    gfClipReflection();\n    vec3 n0_color = uPaint.rgb;\n    float n0_alpha = uPaint.a;\n    vec4 n0_rgba = uPaint;\n    vec2 n1_uv = vUv;\n    float n2_value = gfgNoise(n1_uv * 180.0 + 0.0);\n    float n3_value = uFlakes;\n    float n4_result = (n2_value * n3_value);\n    vec3 n5_result = (n0_color + vec3(n4_result));\n    float n6_value = 0.6;\n    float n7_value = 0.35;\n    float n8_value = 1.0;\n    GFSurface s = gfDefaultSurface();\n    s.albedo = n5_result;\n    s.metallic = n6_value;\n    s.roughness = n7_value;\n    s.clearcoat = n8_value;\n    gfWriteSurface(s);\n}\n"
  }
